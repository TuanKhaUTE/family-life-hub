{
  "name": "family-life-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.21.2",
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace family-life-hub-frontend",
    "build:frontend": "npm run build --workspace family-life-hub-frontend",
    "build:backend": "npm run build --workspace family-life-hub-backend"
  }
}
